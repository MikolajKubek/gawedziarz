{
  "name": "gawedziarz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv/bin/uvicorn backend.main:app --reload --reload-dir backend --port 4317",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && .venv/bin/uvicorn backend.main:app --port 4317",
    "typecheck": "tsc --noEmit",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt && npm install"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
